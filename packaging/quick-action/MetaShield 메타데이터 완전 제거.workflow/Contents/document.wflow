                    <true/>
                    <key>COMMAND_STRING</key>
                <string>cli_path="/Applications/MetaShield.app/Contents/Resources/metashield-cli"

if [[ ! -x "$cli_path" ]]; then
    /usr/bin/osascript -e 'display notification "MetaShield 앱을 /Applications에 설치해 주세요." with title "MetaShield"'
    exit 1
fi

if "$cli_path" --quick-action "$@"; then
    /usr/bin/osascript -e 'display notification "메타데이터 제거와 결과 검증을 완료했습니다." with title "MetaShield"'
else
    /usr/bin/osascript -e 'display notification "일부 이미지를 처리하지 못했습니다. 성공한 파일은 이미 정리됐고 실패한 파일만 변경되지 않았습니다." with title "MetaShield"'
    exit 1
fi</string>
                    <key>inputMethod</key>
